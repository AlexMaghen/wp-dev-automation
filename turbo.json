{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "generate": {
      "dependsOn": [
        "^generate"
      ],
      "outputs": [
        "json-schema/**",
        "test-vectors/**",
        "src/generated/**",
        "../bridge-plugin/wpsync-bridge/includes/protocol.php"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^generate"
      ]
    },
    "test": {
      "dependsOn": [
        "^generate"
      ]
    },
    "test:contract": {
      "dependsOn": [
        "^generate"
      ],
      "cache": false
    },
    "build": {
      "dependsOn": [
        "^generate",
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    }
  }
}
